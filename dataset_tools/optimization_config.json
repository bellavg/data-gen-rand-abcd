{
  "schema_version": 1,
  "notes": "Canonical optimization config source. Edit this file, then re-run slurm_jobs/job_8_make_optimize_scripts.sh.",
  "runtime": {
    "timeout_seconds": 600,
    "threads": 1,
    "chunk_size": 5000,
    "max_retries": 2,
    "dry_run": true
  },
  "tier_policy": {
    "same_parameters_across_tiers": true,
    "tier1_input": "base_aigs",
    "tier2_input": "optimized_aigs/{algorithm}/tier1"
  },
  "algorithms": {
    "Orchestrate": {
      "engine": "orchestrate",
      "deterministic": true,
      "max_passes": 20,
      "score_metric": "area_delay",
      "command_template": "abc -c 'source {abc_rc}; read {input_aig}; strash; orchestrate; write {output_aig}'"
    },
    "Deepsyn": {
      "engine": "deepsyn",
      "record_seed": true,
      "seed_mode": "deterministic_by_input_path",
      "max_passes": 20,
      "command_template": "abc -c 'source {abc_rc}; read {input_aig}; strash; &get; &deepsyn -S {seed}; &put; write {output_aig}'"
    },
    "Syn4": {
      "engine": "syn4",
      "flow_name": "syn4_default",
      "max_passes": 4,
      "deterministic": true,
      "command_template": "abc -c 'source {abc_rc}; read {input_aig}; strash; &get; &syn4; &put; write {output_aig}'"
    },
    "C2RS": {
      "engine": "abc_alias",
      "alias": "c2rs",
      "use_abc_l_flag": true,
      "deterministic": true,
      "command_template": "abc -c 'source {abc_rc}; read {input_aig}; strash; c2rs; write {output_aig}'"
    }
  }
}
